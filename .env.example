# ---- General ----
# Default provider used when a novel does not specify one: "gemini", "ollama", "openai", or "anthropic"
DEFAULT_PROVIDER=gemini

# SQLite database file path
DB_PATH=./data/novels.db

# ---- Authentication ----
# Comma-separated administrator emails. Matching accounts receive full access.
ADMIN_EMAILS=
# Login lifetime in days. Browser sessions are stored server-side and revocable.
AUTH_SESSION_DAYS=30
# Set to true when the application is served over HTTPS.
AUTH_COOKIE_SECURE=false

# ---- Local model (Ollama) ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=gemma4:12b

# ---- Online model (OpenAI-compatible) ----
# Leave OPENAI_API_KEY empty to disable the online provider.
# Works with OpenAI, DeepSeek, and any OpenAI-compatible endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# ---- Online model (Anthropic / Claude) ----
# Leave ANTHROPIC_API_KEY empty to disable this provider.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-opus-4-8

# ---- Gemini via local Antigravity-compatible proxy ----
GEMINI_BASE_URL=http://127.0.0.1:8045
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.6-flash-high

# ---- Generation tuning ----
# Target length (in Chinese characters) per generated chapter
CHAPTER_TARGET_CHARS=2000
# Sampling temperature
TEMPERATURE=0.9
# Request timeout in seconds for a single generation call
REQUEST_TIMEOUT=600

# ---- Imported novels and comics ----
# Maximum upload size in bytes (20 MiB by default). Keep Nginx client_max_body_size at least this large.
UPLOAD_MAX_BYTES=20971520
# Maximum source characters supplied to a style-analysis prompt.
SOURCE_ANALYSIS_MAX_CHARS=30000
# Parsed source-text cap and DOCX archive expansion cap.  These protect the server
# from oversized or highly-compressed uploads.
SOURCE_MAX_EXTRACTED_CHARS=2000000
SOURCE_MAX_CHAPTERS=2000
SOURCE_DOCX_MAX_UNCOMPRESSED_BYTES=41943040
# Concurrent CPU-heavy parsing / source import / AI style-analysis jobs.
SOURCE_PARSE_MAX_CONCURRENCY=2
IMPORT_WORKER_MAX_CONCURRENCY=2
STYLE_ANALYSIS_MAX_CONCURRENCY=1
# Durable directory for generated comic panels. It must be inside the Docker data volume.
MEDIA_DIR=./data
COMIC_DEFAULT_IMAGE_MODEL=gemini-3-pro-image
COMIC_DEFAULT_ASPECT_RATIO=16:9
COMIC_DEFAULT_QUALITY=standard
COMIC_DEFAULT_PANEL_COUNT=6
# The Antigravity proxy is quota-limited; render this many comic jobs at once.
COMIC_MAX_CONCURRENT_JOBS=1

# ---- Docker image overrides (optional) ----
# Set these on the server when deploying images pulled from a registry.
BACKEND_IMAGE=novel-generator-backend:0.0.1
FRONTEND_IMAGE=novel-generator-frontend:0.0.1
